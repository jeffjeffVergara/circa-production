              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/preventas?limit=20"
              }
            },
            {
              "name": "SVC-06 Listar pedidos",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/pedidos?limit=20"
              }
            },
