                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [{ "key": "Content-Type", "value": "application/json" }],
                  "body": "{\n  \"id\": \"p1e2d3i4-0001-4000-8000-000000000001\",\n  \"estado\": \"preventa_aceptada\",\n  \"es_test\": false\n}"
