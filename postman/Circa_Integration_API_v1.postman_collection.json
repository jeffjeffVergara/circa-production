          ]
        },
        {
          "name": "SVC-01 Casos (ejemplos situacion)",
          "description": "Matriz de `situacion`. Completar variables `q_dni_*` con DNIs reales del distribuidor.",
          "item": [
            {
              "name": "TP-01 No encuentra → no_registrada",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                      "const j = pm.response.json();",
                      "pm.test('lista vacía', function () { pm.expect(j.total).to.eql(0); pm.expect(j.items).to.eql([]); });",
                      "pm.test('situacion no_registrada', function () { pm.expect(j.situacion).to.eql('no_registrada'); });"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/bodegas?q={{q_dni_inexistente}}&limit=20",
                "description": "Siguiente paso: **SVC-02**."
              },
