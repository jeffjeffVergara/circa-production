                  "body": "{\n  \"total\": 1,\n  \"situacion\": \"en_evaluacion\",\n  \"items\": [\n    {\n      \"id\": \"a1b2c3d4-0001-4000-8000-000000000099\",\n      \"telefono_whatsapp\": \"+51987654321\",\n      \"dni_representante\": \"42868000\",\n      \"razon_social\": \"BODEGA DEMO SOCIO\",\n      \"estado\": \"inactivo\",\n      \"onboarding_fase\": \"precargada\",\n      \"linea_aprobada\": 200.0,\n      \"linea_disponible\": 0.0,\n      \"situacion\": \"en_evaluacion\",\n      \"tiene_foto_dueno\": true,\n      \"tiene_foto_bodega\": true,\n      \"es_test\": false,\n      \"created\": false\n    }\n  ]\n}"
                },
                {
