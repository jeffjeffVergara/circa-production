                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [{ "key": "Content-Type", "value": "application/json" }],
                  "body": "{\n  \"total\": 1,\n  \"situacion\": \"con_linea\",\n  \"items\": [\n    {\n      \"id\": \"a1b2c3d4-0001-4000-8000-000000000011\",\n      \"telefono_whatsapp\": \"+51987654321\",\n      \"dni_representante\": \"07631909\",\n      \"razon_social\": \"BODEGA ACTIVA\",\n      \"estado\": \"activo\",\n      \"linea_aprobada\": 500.0,\n      \"linea_disponible\": 350.0,\n      \"situacion\": \"con_linea\",\n      \"tiene_foto_dueno\": true,\n      \"tiene_foto_bodega\": true,\n      \"es_test\": false,\n      \"created\": false\n    }\n  ]\n}"
                },
                {
                  "name": "200 — no_disponible",
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [{ "key": "Content-Type", "value": "application/json" }],
                  "body": "{\n  \"total\": 1,\n  \"situacion\": \"no_disponible\",\n  \"items\": [\n    {\n      \"id\": \"a1b2c3d4-0001-4000-8000-000000000012\",\n      \"estado\": \"activo\",\n      \"linea_aprobada\": 500.0,\n      \"linea_disponible\": 0.0,\n      \"situacion\": \"no_disponible\",\n      \"es_test\": false,\n      \"created\": false\n    }\n  ]\n}"
                }
              ]
            },
            {
              "name": "SVC-01b Obtener bodega",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/bodegas/{{bodega_id}}",
                "description": "Refresco de una bodega por UUID Circa.\n\nUsar tras SVC-02 para ver si pasó de `en_evaluacion` a `con_linea`."
              },
              "response": [
                {
                  "name": "200 — bodega",
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [{ "key": "Content-Type", "value": "application/json" }],
                  "body": "{\n  \"id\": \"a1b2c3d4-0001-4000-8000-000000000099\",\n  \"telefono_whatsapp\": \"+51987654321\",\n  \"dni_representante\": \"42868000\",\n  \"razon_social\": \"BODEGA DEMO SOCIO\",\n  \"estado\": \"inactivo\",\n  \"onboarding_fase\": \"precargada\",\n  \"linea_aprobada\": 200.0,\n  \"linea_disponible\": 0.0,\n  \"situacion\": \"en_evaluacion\",\n  \"tiene_foto_dueno\": true,\n  \"tiene_foto_bodega\": true,\n  \"es_test\": false,\n  \"created\": false\n}"
                },
                {
                  "name": "404 — no existe",
                  "status": "Not Found",
                  "code": 404,
                  "_postman_previewlanguage": "json",
                  "header": [{ "key": "Content-Type", "value": "application/json" }],
                  "body": "{\n  \"detail\": \"Bodega no encontrada\"\n}"
                }
              ]
            },
            {
              "name": "SVC-03 Patch bodega",
              "request": {
                "method": "PATCH",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"nombre_comercial\": \"Bodega Demo Actualizada\",\n  \"distrito\": \"Surquillo\",\n  \"direccion_fiscal\": \"Av. Nueva 456\"\n}"
                },
                "url": "{{baseUrl}}/bodegas/{{bodega_id}}",
                "description": "Corregir datos (JSON). No envía fotos."
              },
              "response": [
                {
                  "name": "200 — actualizada",
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [{ "key": "Content-Type", "value": "application/json" }],
                  "body": "{\n  \"id\": \"a1b2c3d4-0001-4000-8000-000000000099\",\n  \"nombre_comercial\": \"Bodega Demo Actualizada\",\n  \"distrito\": \"Surquillo\",\n  \"situacion\": \"en_evaluacion\",\n  \"created\": false\n}"
                }
              ]
            }
          ]
        },
        {
          "name": "Preventas / Pedidos",
          "description": "SVC-04 crear · SVC-05 consultar · SVC-07 estados. Requiere `situacion=con_linea`.",
          "item": [
            {
              "name": "SVC-04 Crear preventa",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "  var d = pm.response.json();",
                      "  if (d.id) pm.collectionVariables.set('pedido_id', d.id);",
                      "}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"external_id\": \"SOCIO-PV-001\",\n  \"bodega_id\": \"{{bodega_id}}\",\n  \"vendedor_codigo\": \"VW01\",\n  \"monto_a_financiar\": 31.0,\n  \"plazo_dias\": 7,\n  \"items\": [\n    {\n      \"sku\": \"P0001\",\n      \"nombre\": \"Producto demo\",\n      \"cantidad\": 2,\n      \"precio_unitario\": 15.5\n    }\n  ]\n}"
                },
                "url": "{{baseUrl}}/preventas",
                "description": "## SVC-04 — Solicitar financiamiento\n\nObligatorios: `bodega_id` (o alternativa), `items`, **`monto_a_financiar`**, **`plazo_dias`** (7|15|30).\n\n### Request ejemplo\n```json\n{\n  \"bodega_id\": \"<uuid Circa>\",\n  \"monto_a_financiar\": 31.0,\n  \"plazo_dias\": 7,\n  \"vendedor_codigo\": \"VW01\",\n  \"items\": [\n    { \"sku\": \"P0001\", \"nombre\": \"Producto demo\", \"cantidad\": 2, \"precio_unitario\": 15.5 }\n  ]\n}\n```"
              },
              "response": [
                {
                  "name": "200 — preventa creada",
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [{ "key": "Content-Type", "value": "application/json" }],
                  "body": "{\n  \"id\": \"p1e2d3i4-0001-4000-8000-000000000001\",\n  \"external_id\": \"SOCIO-PV-001\",\n  \"bodega_id\": \"a1b2c3d4-0001-4000-8000-000000000011\",\n  \"estado\": \"preventa_confirmada\",\n  \"total_pedido\": 31.0,\n  \"monto_financiado\": 31.0,\n  \"plazo_dias\": 7\n}"
                }
              ]
            },
            {
              "name": "SVC-05 Obtener preventa",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/preventas/{{pedido_id}}",
                "description": "Polling del resultado de la solicitud."
              }
            },
            {
